<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!-- ОДИН persistence unit для всех сущностей -->
    <persistence-unit name="lab4-persistence-unit" transaction-type="JTA">
        <jta-data-source>java:jboss/datasources/PostgreDS</jta-data-source>
        <!-- Провайдер Hibernate -->
        <!--<provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>-->

        <!-- ЯВНО перечисляем ВСЕ сущности -->
        <class>mkkz7.entities.User</class>
        <class>mkkz7.entities.PointResult</class>

        <properties>
            <!-- ========== HIBERNATE НАСТРОЙКИ ========== -->
            <!-- Стратегия генерации схемы (create, update, validate, none) -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <!-- Диалект БД (автоматически определяется, но можно указать явно) -->
            <!-- Для PostgreSQL -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>

            <!-- Логирование SQL -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

            <!-- Параметры в логах -->
            <property name="hibernate.use_sql_comments" value="true"/>

        </properties>
    </persistence-unit>
</persistence>